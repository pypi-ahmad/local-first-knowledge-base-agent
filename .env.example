# Copy this file to .env and fill in the keys you actually use.
# Never commit your real .env file.

# --- Ollama (local, required) ---
OLLAMA_BASE_URL=http://localhost:11434
# Vision-capable model for image OCR/captioning (must be pulled: `ollama pull qwen3-vl:4b`)
OLLAMA_VISION_MODEL=qwen3-vl:4b

# --- OpenAI-compatible (models: gpt-5.6-luna, gpt-5.6-terra) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Agnes AI (model: agnes-2.5-flash, base URL: https://apihub.agnes-ai.com/v1) ---
AGNES_API_KEY=

# --- Google Gemini (models: gemini-3.5-flash-lite, gemini-3.7-flash) ---
GOOGLE_API_KEY=

# --- Local audio transcription (faster-whisper) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Privacy ---
# When true, only Ollama may be used; remote providers are refused at runtime.
LOCAL_ONLY_MODE=false
